#include <stdint.h>

// Compiles to the same LLVM i128 operations that back Swift's UInt128. Not available on 32-bit targets such as armv7k.
#ifdef __SIZEOF_INT128__

static inline int uint128_native_available(void) { return 1; }

// out = { upper, lower } of either the quotient or the remainder of a / b
static inline void uint128_divrem(
    uint64_t a_hi, uint64_t a_lo, uint64_t b_hi, uint64_t b_lo, int remainder, uint64_t *out) {
    unsigned __int128 a = ((unsigned __int128) a_hi << 64) | a_lo;
    unsigned __int128 b = ((unsigned __int128) b_hi << 64) | b_lo;
    unsigned __int128 r = remainder ? a % b : a / b;
    out[0] = (uint64_t) (r >> 64);
    out[1] = (uint64_t) r;
}

#else

static inline int uint128_native_available(void) { return 0; }

static inline void uint128_divrem(
    uint64_t a_hi, uint64_t a_lo, uint64_t b_hi, uint64_t b_lo, int remainder, uint64_t *out) {}

#endif
